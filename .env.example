# PostgreSQL

POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=auth_password


# Auth / JWT

APP_NAME=Auth Service
ENVIRONMENT=development

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000


# Handler

HANDLER_PROVIDER=llamacpp # local

AGENT_INFERENCE_PROVIDER=llamacpp

LLAMACPP_BASE_URL=http://host.docker.internal:8081
LLAMACPP_MODEL=Qwen3-4B
LLAMACPP_MAX_NEW_TOKENS=128
LLAMACPP_TEMPERATURE=0.0
LLAMACPP_TIMEOUT=120

HANDLER_MODEL=Qwen2.5-3B-Instruct
HANDLER_DEVICE=cpu
HANDLER_TORCH_DTYPE=float32

AGENT_DEVICE=cpu
AGENT_TORCH_DTYPE=float32
DEFAULT_AGENT_MODEL=Qwen2.5-3B-Instruct

HANDLER_MAX_NEW_TOKENS=128
HANDLER_DO_SAMPLE=false
HANDLER_TEMPERATURE=0.2

# =========================
# GigaChat
# =========================

GIGACHAT_CREDENTIALS=""
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_VERIFY_SSL_CERTS=false

# Semantic routing
MODELS_DIR=/project/models
EMBEDDING_MODEL_PATH=/project/models/bge-m3
RERANKER_MODEL_PATH=/project/models/bge-reranker-v2-m3
EMBEDDING_DEVICE=cpu

# Other configs
AGENT_PROPOSER_PROVIDER=local #gigachat
AGENT_PROPOSER_MODEL_NAME=Qwen2.5-3B-Instruct
AGENT_PROPOSER_DEVICE=cpu
AGENT_PROPOSER_TORCH_DTYPE=float32

COMPLEXITY_ROUTER_ENABLED=true
COMPLEXITY_ROUTER_PATH=/project/models/complexity_router
COMPLEXITY_ROUTER_DEVICE=cpu   # cpu/cuda

DRAWING_OCR_BACKEND=rapidocr
DRAWING_OCR_MIN_CONF=50
DRAWING_SCAN_MODE=auto
DRAWING_CLIP_ENABLED=false

EMBEDDING_MODEL_PATH=/project/models/bge-m3
RERANKER_MODEL_PATH=/project/models/reranker
EMBEDDING_DEVICE=cpu